{
  "ai_engine": "openai_api",
  "openai_api": {
    "api_key": "",
    "api_base": "https://api.xiaomimimo.com/v1",
    "model": "mimo-v2.6-flash",
    "temperature": 0.7
  },
  "system_prompt": "你现在是微信账号的主人（真实本人）。请以我（主人本人）的第一人称、自然口语、亲切随和的日常语气直接回复微信好友的消息。就像我本人在用手机打字聊天一样自然。严禁透露任何AI、机器人或助理身份，严禁使用客套机械的客服腔，严禁输出任何解释或markdown格式，直接输出我回复的那句话。",
  "reply_prefix": "[AI自动回复] ",
  "include_prefix": false,
  "whitelist_mode": true,
  "contacts": [
    {
      "remark": "好友备注A",
      "wxid": "wxid_xxxxxxxx"
    },
    {
      "remark": "好友备注B",
      "wxid": ""
    }
  ],
  "whitelist": [
    "好友备注A",
    "好友备注B"
  ],
  "blacklist": [
    "微信团队",
    "文件传输助手",
    "腾讯新闻",
    "微信支付",
    "服务通知",
    "订阅号消息"
  ],
  "reply_delay_seconds": 0.0,
  "check_interval_seconds": 0.5,
  "auto_focus_wechat": false,
  "ignored_keywords": [
    "按住鼠标",
    "语音输入文字",
    "按住说话",
    "按Enter发送",
    "发送(S)"
  ],
  "agent": {
    "enabled": true,
    "url": "http://127.0.0.1:44708/a2a",
    "card_url": "http://127.0.0.1:44708/.well-known/agent-card.json",
    "context_prefix": "wx-",
    "timeout_seconds": 180,
    "connect_timeout_seconds": 5,
    "retries": 1,
    "max_defer_seconds": 900,
    "context_map_file": "wechat_agent_contexts.json",
    "fallback_replies": [
      "嘿嘿，我这会儿有点懵，等下再聊~",
      "啊呀，脑子突然卡壳了，晚点回你哈",
      "我这边有点小状况，一会儿再来找你~",
      "等等我，手头有点事，马上回来！"
    ],
    "voice": {
      "enabled": false,
      "mode": "bubble",
      "max_chars": 120,
      "voice": "",
      "instruction": "",
      "edge_fallback": true,
      "edge_voice": "zh-CN-XiaoxuanNeural",
      "timeout": 180,
      "fallback_file": true,
      "virtual_source": "wx_tts_source",
      "virtual_sink": "wx_tts_sink",
      "record_tail": 0.45,
      "min_record_seconds": 1.2
    }
  },
  "proactive_send": {
    "enabled": false,
    "host": "127.0.0.1",
    "port": 8765,
    "whitelist_only": true,
    "max_per_hour": 3,
    "max_per_day": 20,
    "require_confirm": false,
    "allow_search": true,
    "confirm_expire_hours": 12
  },
  "saved_window_rect": [
    100,
    100,
    1100,
    750
  ]
}
